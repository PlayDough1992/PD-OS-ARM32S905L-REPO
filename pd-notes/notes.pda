/*
 * notes.pda — Desktop Scratchpad & Notes for PD-OS
 *
 * Build: open in PD-Text, press Build → Compile + Run
 * Or compile via terminal: tcc /home/pd/Documents/notes.c
 */
#include <app.h>
#include <stdio.h>
#include <string.h>
#include <stdlib.h>

#define WIN_W   340
#define WIN_H   280

#define MAX_LINES 8
static char g_lines[MAX_LINES][48] = {
    "Welcome to PD-OS Notes!",
    "- Standalone .pda application",
    "- Direct window rendering",
    "- Auto-updates without kernel reboot",
    "",
    "Click lines to toggle task checks [X]",
    "Task 1: Install apps via pdpm",
    "Task 2: Enjoy high-performance ARM32 OS"
};

static void on_click(app_window_t *win, int mx, int my)
{
    /* Check lines clicked to toggle mark */
    for (int i = 0; i < MAX_LINES; i++) {
        int ly = 40 + i * 24;
        if (my >= ly && my < ly + 20 && mx >= 16 && mx < WIN_W - 16) {
            if (g_lines[i][0] == '[') {
                if (g_lines[i][1] == ' ') g_lines[i][1] = 'X';
                else if (g_lines[i][1] == 'X') g_lines[i][1] = ' ';
            } else if (strncmp(g_lines[i], "Task", 4) == 0) {
                /* Prepend checkmark */
                char tmp[48];
                snprintf(tmp, sizeof(tmp), "[X] %s", g_lines[i]);
                strncpy(g_lines[i], tmp, sizeof(g_lines[i]));
            }
            return;
        }
    }
    (void)win;
}

static void on_draw(app_window_t *win)
{
    /* Background */
    app_fill_rect(win, 0, 0, WIN_W, WIN_H, APP_BG);

    /* Header Bar */
    app_fill_rect(win, 0, 0, WIN_W, 30, APP_RGB(35, 40, 52));
    app_draw_string(win, 12, 8, "PD-OS Desktop Scratchpad", APP_WHITE);

    /* Note Container Box */
    app_fill_rect(win, 10, 36, WIN_W - 20, WIN_H - 46, APP_RGB(25, 26, 32));
    app_draw_rect(win, 10, 36, WIN_W - 20, WIN_H - 46, APP_MID_GREY);

    /* Render text lines */
    for (int i = 0; i < MAX_LINES; i++) {
        int ly = 46 + i * 24;
        uint32_t col = (i == 0) ? APP_RGB(100, 200, 255) :
                       (g_lines[i][0] == '[' && g_lines[i][1] == 'X') ? APP_RGB(100, 220, 120) :
                       APP_WHITE;
        app_draw_string(win, 20, ly, g_lines[i], col);
        app_fill_rect(win, 20, ly + 18, WIN_W - 40, 1, APP_RGB(40, 42, 50));
    }
}

void app_main(void)
{
    app_window_t *win = app_create("Notes", WIN_W, WIN_H);
    if (!win) return;
    app_set_draw (win, on_draw);
    app_set_click(win, on_click);
    app_run(win);
}
