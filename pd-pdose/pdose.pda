    0x35, 0x00, 0x12, 0x0E, 0xD0, 0x14, 0x64, 0x02,
    0xE4, 0xA1, 0x63, 0xFF, 0x64, 0x08, 0xE4, 0xA1,
    0x63, 0x01, 0x64, 0x04, 0xE4, 0xA1, 0x62, 0xFF,
    0x64, 0x06, 0xE4, 0xA1, 0x62, 0x01, 0x80, 0x24,
    0x81, 0x34, 0x40, 0x3B, 0x62, 0xFF, 0x40, 0x01,
    0x62, 0x01, 0x41, 0x1B, 0x63, 0xFF, 0x41, 0x01,
    0x63, 0x01, 0xD0, 0x14, 0x65, 0x01, 0xF5, 0x15,
    0x12, 0x0E, 0x00, 0x00, 0x00, 0x00, 0x60, 0xF0,
    0xF0, 0x60
};

/* Crisp 1024-tile VBlank-synced Game Boy DMG Test ROM */
static uint8_t g_gb_demo_rom[512];
static void build_gb_demo_rom(void)
{
    memset(g_gb_demo_rom, 0, sizeof(g_gb_demo_rom));
    g_gb_demo_rom[0x100] = 0x00;
    g_gb_demo_rom[0x101] = 0xC3;
    g_gb_demo_rom[0x102] = 0x50;
    g_gb_demo_rom[0x103] = 0x01;
    memcpy(g_gb_demo_rom + 0x134, "PDOSE DMG TEST", 14);

    static const uint8_t prog[] = {
        0xF3, 0x21, 0x10, 0x80, 0x3E, 0xFF, 0x22, 0x22,
        0x06, 0x06, 0x3E, 0x81, 0x22, 0x3E, 0xBD, 0x22,
        0x05, 0x20, 0xF7, 0x3E, 0xFF, 0x22, 0x22, 0x21,
        0x00, 0x98, 0x0E, 0x04, 0x06, 0x80, 0x3E, 0x01,
        0x22, 0xAF, 0x22, 0x05, 0x20, 0xF8, 0x0D, 0x20,
        0xF3, 0xF0, 0x44, 0xFE, 0x90, 0x20, 0xFA, 0xF0,
        0x43, 0x3C, 0xE0, 0x43, 0xF0, 0x44, 0xFE, 0x90,
        0x28, 0xFA, 0x18, 0xED
    };
    memcpy(g_gb_demo_rom + 0x150, prog, sizeof(prog));
}

/* ============================================================================
 * PDOSE Frontend State & Libretro Callbacks
 * ============================================================================ */

#define WIN_W       560
#define WIN_H       420
#define VIEW_X       12
#define VIEW_Y       42
#define VIEW_W      384
#define VIEW_H      256
#define SIDE_X      408
#define SIDE_W      140

#define MAX_FB_W    256
#define MAX_FB_H    240

static const pdose_core_t g_cores[2] = {
    {
        "chip8", "CHIP-8 Core", "/home/pd/roms/game.ch8",
        c8_api_version, c8_init, c8_deinit,
        c8_set_env, c8_set_vid, c8_set_aud, c8_set_aud_batch,
        c8_set_poll, c8_set_in, c8_get_sys_info, c8_get_av_info,
        c8_load_game, c8_unload_game, c8_run, c8_reset,
        c8_ser_size, c8_ser, c8_unser
    },
    {
        "gb", "Game Boy Core", "/home/pd/roms/game.gb",
        gb_api_version, gb_init, gb_deinit,
        gb_set_env, gb_set_vid, gb_set_aud, gb_set_aud_batch,
        gb_set_poll, gb_set_in, gb_get_sys_info, gb_get_av_info,
        gb_load_game, gb_unload_game, gb_run, gb_reset,
        gb_ser_size, gb_ser, gb_unser
    }
};

static int                     g_core_idx   = 0;
static int                     g_running    = 1;
static int                     g_rom_loaded = 0;
static uint32_t                g_frames     = 0;
static enum retro_pixel_format g_pix_fmt    = RETRO_PIXEL_FORMAT_XRGB8888;
static uint32_t                g_fb[MAX_FB_W * MAX_FB_H];
static unsigned                g_fb_w       = 0;
static unsigned                g_fb_h       = 0;
static uint16_t                g_pad_mask   = 0;
static void                   *g_savestate  = NULL;
static size_t                  g_savestate_sz = 0;
static char                    g_status[80] = "PDOSE ready — Libretro ABI v1";
static char                    g_rom_name[40] = "Built-in Bounce";

static bool fe_env_cb(unsigned cmd, void *data)
{
    switch (cmd) {
        case RETRO_ENVIRONMENT_SET_PIXEL_FORMAT:
            if (data) {
                g_pix_fmt = *(const enum retro_pixel_format *)data;
                return true;
            }
            return false;
        case RETRO_ENVIRONMENT_GET_SYSTEM_DIRECTORY:
            if (data) { *(const char **)data = "/home/pd/roms"; return true; }
            return false;
        case RETRO_ENVIRONMENT_GET_SAVE_DIRECTORY:
            if (data) { *(const char **)data = "/home/pd/saves"; return true; }
            return false;
        default:
            return false;
    }
}

static uint32_t conv_rgb565(uint16_t p)
{
    uint8_t r = (uint8_t)(((p >> 11) & 0x1Fu) << 3);
    uint8_t g = (uint8_t)(((p >>  5) & 0x3Fu) << 2);
    uint8_t b = (uint8_t)(( p        & 0x1Fu) << 3);
    return APP_RGB(r, g, b);
}

static uint32_t conv_0rgb1555(uint16_t p)
{
    uint8_t r = (uint8_t)(((p >> 10) & 0x1Fu) << 3);
    uint8_t g = (uint8_t)(((p >>  5) & 0x1Fu) << 3);
    uint8_t b = (uint8_t)(( p        & 0x1Fu) << 3);
    return APP_RGB(r, g, b);
}

static void fe_video_cb(const void *data, unsigned width, unsigned height, size_t pitch)
{
    if (!data || width == 0 || height == 0) return;
    if (width > MAX_FB_W) width = MAX_FB_W;
    if (height > MAX_FB_H) height = MAX_FB_H;
    g_fb_w = width;
    g_fb_h = height;

    const uint8_t *src = (const uint8_t *)data;
    for (unsigned y = 0; y < height; y++) {
        const uint8_t *row = src + y * pitch;
        uint32_t *dst = g_fb + y * width;
        if (g_pix_fmt == RETRO_PIXEL_FORMAT_XRGB8888) {
            memcpy(dst, row, width * sizeof(uint32_t));
        } else if (g_pix_fmt == RETRO_PIXEL_FORMAT_RGB565) {
            const uint16_t *r16 = (const uint16_t *)row;
            for (unsigned x = 0; x < width; x++) dst[x] = conv_rgb565(r16[x]);
        } else {
            const uint16_t *r16 = (const uint16_t *)row;
            for (unsigned x = 0; x < width; x++) dst[x] = conv_0rgb1555(r16[x]);
        }
    }
}

static void fe_audio_cb(int16_t l, int16_t r) { (void)l; (void)r; }
static size_t fe_audio_batch_cb(const int16_t *d, size_t f) { (void)d; return f; }
static void fe_input_poll_cb(void) { /* Input state updated via UI / pad mask */ }

static int16_t fe_input_state_cb(unsigned port, unsigned device,
                                 unsigned index, unsigned id)
{
    if (port != 0 || device != RETRO_DEVICE_JOYPAD || index != 0 || id >= 16)
        return 0;
    return (g_pad_mask & (1u << id)) ? 1 : 0;
}

static void pdose_select_core(int idx)
{
    if (idx < 0 || idx >= 2) return;
    if (g_rom_loaded) {
        g_cores[g_core_idx].unload_game();
        g_cores[g_core_idx].deinit();
        g_rom_loaded = 0;
    }
    if (g_savestate) { free(g_savestate); g_savestate = NULL; g_savestate_sz = 0; }

    g_core_idx = idx;
    const pdose_core_t *c = &g_cores[g_core_idx];
    c->set_environment(fe_env_cb);
    c->set_video_refresh(fe_video_cb);
    c->set_audio_sample(fe_audio_cb);
    c->set_audio_sample_batch(fe_audio_batch_cb);
    c->set_input_poll(fe_input_poll_cb);
    c->set_input_state(fe_input_state_cb);
    c->init();

    struct retro_game_info gi;
    memset(&gi, 0, sizeof(gi));
    if (idx == 0) {
        gi.path = "builtin://bounce.ch8";
        gi.data = ROM_C8_BOUNCE;
        gi.size = sizeof(ROM_C8_BOUNCE);
        snprintf(g_rom_name, sizeof(g_rom_name), "Built-in Bounce.ch8");
    } else {
        build_gb_demo_rom();
        gi.path = "builtin://dmg_test.gb";
        gi.data = g_gb_demo_rom;
        gi.size = sizeof(g_gb_demo_rom);
        snprintf(g_rom_name, sizeof(g_rom_name), "Built-in DMG Test.gb");
    }

    g_rom_loaded = c->load_game(&gi) ? 1 : 0;
    g_frames = 0;
    if (g_rom_loaded) {
        c->run();
        g_frames++;
        struct retro_system_info si;
        c->get_system_info(&si);
        snprintf(g_status, sizeof(g_status), "Loaded %s v%s (ABI v%u)",
                 si.library_name, si.library_version, c->api_version());
    } else {
        snprintf(g_status, sizeof(g_status), "Error: Failed to load ROM");
    }
}

static void pdose_load_external_rom(void)
{
    const pdose_core_t *c = &g_cores[g_core_idx];
    FILE *fp = fopen(c->default_rom_path, "rb");
    if (!fp) {
        snprintf(g_status, sizeof(g_status), "No ROM at %s", c->default_rom_path);
        return;
    }
    fseek(fp, 0, SEEK_END);
    long sz = ftell(fp);
    fseek(fp, 0, SEEK_SET);
    if (sz <= 0 || sz > 2 * 1024 * 1024) {
        fclose(fp);
        snprintf(g_status, sizeof(g_status), "Invalid ROM size (%ld bytes)", sz);
        return;
    }
    uint8_t *buf = (uint8_t *)malloc((size_t)sz);
    if (!buf) {
        fclose(fp);
        snprintf(g_status, sizeof(g_status), "Out of memory loading ROM");
        return;
    }
    size_t rd = fread(buf, 1, (size_t)sz, fp);
    fclose(fp);

    struct retro_game_info gi;
    memset(&gi, 0, sizeof(gi));
    gi.path = c->default_rom_path;
    gi.data = buf;
    gi.size = rd;

    if (c->load_game(&gi)) {
        g_rom_loaded = 1;
        g_frames = 0;
        snprintf(g_rom_name, sizeof(g_rom_name), "%s", c->default_rom_path);
        c->run();
        g_frames++;
        snprintf(g_status, sizeof(g_status), "Loaded external ROM (%u bytes)", (unsigned)rd);
    } else {
        snprintf(g_status, sizeof(g_status), "Core rejected ROM file");
    }
    free(buf);
}

static void pdose_step_frames(int n)
{
    if (!g_rom_loaded) return;
    const pdose_core_t *c = &g_cores[g_core_idx];
    for (int i = 0; i < n; i++) {
        c->run();
        g_frames++;
    }
}

/* ============================================================================
 * GUI Rendering & Input Handlers (<app.h>)
 * ============================================================================ */

static void draw_btn(app_window_t *win, int x, int y, int w, int h,
                     const char *lbl, uint32_t bg, uint32_t border)
{
    app_fill_rect(win, x, y, w, h, bg);
    app_draw_rect(win, x, y, w, h, border);
    app_draw_text_center(win, x + w / 2, y + (h - 14) / 2, lbl, APP_WHITE);
}

static int hit(int mx, int my, int x, int y, int w, int h)
{
    return (mx >= x && mx < x + w && my >= y && my < y + h);
}

static void on_click(app_window_t *win, int mx, int my)
{
    (void)win;
    /* Sidebar buttons */
    if (hit(mx, my, SIDE_X, 62, SIDE_W, 26)) { pdose_select_core(0); return; }
    if (hit(mx, my, SIDE_X, 94, SIDE_W, 26)) { pdose_select_core(1); return; }
    if (hit(mx, my, SIDE_X, 134, SIDE_W, 26)) { pdose_load_external_rom(); return; }
    if (hit(mx, my, SIDE_X, 174, SIDE_W, 26)) {
        g_running = !g_running;
        snprintf(g_status, sizeof(g_status), g_running ? "Emulation Running" : "Emulation Paused");
        return;
    }
    if (hit(mx, my, SIDE_X, 206, SIDE_W, 26)) {
        pdose_step_frames(4);
        snprintf(g_status, sizeof(g_status), "Stepped to frame %u", (unsigned)g_frames);
        return;
    }
    if (hit(mx, my, SIDE_X, 238, SIDE_W, 26)) {
        if (g_rom_loaded) {
            g_cores[g_core_idx].reset();
            g_frames = 0;
            pdose_step_frames(1);
            snprintf(g_status, sizeof(g_status), "Core reset");
        }
        return;
    }
    if (hit(mx, my, SIDE_X, 278, 66, 26)) {
        /* Save State */
        const pdose_core_t *c = &g_cores[g_core_idx];
        size_t sz = c->serialize_size();
        if (sz > 0) {
            if (g_savestate) free(g_savestate);
            g_savestate = malloc(sz);
            if (g_savestate && c->serialize(g_savestate, sz)) {
                g_savestate_sz = sz;
                snprintf(g_status, sizeof(g_status), "State saved (%u B)", (unsigned)sz);
            }
        }
        return;
    }
    if (hit(mx, my, SIDE_X + 74, 278, 66, 26)) {
        /* Load State */
        const pdose_core_t *c = &g_cores[g_core_idx];
        if (g_savestate && c->unserialize(g_savestate, g_savestate_sz)) {
            pdose_step_frames(1);
            snprintf(g_status, sizeof(g_status), "State restored");
        } else {
            snprintf(g_status, sizeof(g_status), "No save state available");
        }
        return;
    }
}

static void on_key(app_window_t *win, char k)
{
    (void)win;
    uint16_t mask = 0;
    if (k == 0x11 || k == 'w' || k == 'W') mask = (1u << RETRO_DEVICE_ID_JOYPAD_UP);
    else if (k == 0x12 || k == 's' || k == 'S') mask = (1u << RETRO_DEVICE_ID_JOYPAD_DOWN);
    else if (k == 0x13 || k == 'a' || k == 'A') mask = (1u << RETRO_DEVICE_ID_JOYPAD_LEFT);
    else if (k == 0x14 || k == 'd' || k == 'D') mask = (1u << RETRO_DEVICE_ID_JOYPAD_RIGHT);
    else if (k == 'z' || k == 'Z' || k == 'j' || k == 'J') mask = (1u << RETRO_DEVICE_ID_JOYPAD_A);
    else if (k == 'x' || k == 'X' || k == 'k' || k == 'K') mask = (1u << RETRO_DEVICE_ID_JOYPAD_B);
    else if (k == 0x0A) mask = (1u << RETRO_DEVICE_ID_JOYPAD_START);
    else if (k == 0x09 || k == 0x08) mask = (1u << RETRO_DEVICE_ID_JOYPAD_SELECT);
    else if (k == 'p' || k == 'P') { g_running = !g_running; return; }
    else if (k == 'r' || k == 'R') {
        if (g_rom_loaded) { g_cores[g_core_idx].reset(); g_frames = 0; }
        return;
    }
    if (mask) {
        g_pad_mask = mask;
        pdose_step_frames(2);
        g_pad_mask = 0;
    }
}

static void on_tick(app_window_t *win, uint32_t dt_ms)
{
    (void)dt_ms;
    if (g_running && g_rom_loaded) {
        pdose_step_frames(1);
        app_mark_dirty(win);
    }
}

static void on_draw(app_window_t *win)
{
    /* Window Background */
    app_fill_rect(win, 0, 0, WIN_W, WIN_H, APP_RGB(18, 20, 28));

    /* Header Bar */
    app_fill_rect(win, 0, 0, WIN_W, 32, APP_RGB(28, 38, 58));
    app_draw_string(win, 12, 8, "PDOSE - Libretro Emulator", APP_WHITE);
    char hdr[48];
    snprintf(hdr, sizeof(hdr), "Frame: %u | %s", (unsigned)g_frames,
             g_running ? "60Hz" : "PAUSE");
    app_draw_text_right(win, WIN_W - 12, 8, hdr, APP_RGB(120, 220, 255));

    /* Emulation Viewport Bezel */
    app_fill_rect(win, VIEW_X - 2, VIEW_Y - 2, VIEW_W + 4, VIEW_H + 4, APP_RGB(8, 10, 14));
    app_draw_rect(win, VIEW_X - 2, VIEW_Y - 2, VIEW_W + 4, VIEW_H + 4, APP_RGB(65, 85, 120));

    /* Blit Libretro Framebuffer scaled to viewport */
    if (g_fb_w > 0 && g_fb_h > 0) {
        int scale = (int)(VIEW_W / g_fb_w);
        int sy_sc = (int)(VIEW_H / g_fb_h);
        if (sy_sc < scale) scale = sy_sc;
        if (scale < 1) scale = 1;
        int dw = (int)g_fb_w * scale;
        int dh = (int)g_fb_h * scale;
        int ox = VIEW_X + (VIEW_W - dw) / 2;
        int oy = VIEW_Y + (VIEW_H - dh) / 2;
        app_blit_rgb32(win, ox, oy, g_fb, (int)g_fb_w, (int)g_fb_h, scale);
    } else {
        app_draw_text_center(win, VIEW_X + VIEW_W / 2, VIEW_Y + VIEW_H / 2 - 8,
                             "No Video Signal", APP_MID_GREY);
    }

    /* Right Sidebar: Core & Playback Controls */
    app_draw_string(win, SIDE_X, 42, "LIBRETRO CORES", APP_RGB(150, 175, 210));
    draw_btn(win, SIDE_X, 62, SIDE_W, 26, "CHIP-8",
             g_core_idx == 0 ? APP_BTN_OP : APP_BTN,
             g_core_idx == 0 ? APP_WHITE  : APP_MID_GREY);
    draw_btn(win, SIDE_X, 94, SIDE_W, 26, "Game Boy (DMG)",
             g_core_idx == 1 ? APP_BTN_OP : APP_BTN,
             g_core_idx == 1 ? APP_WHITE  : APP_MID_GREY);

    draw_btn(win, SIDE_X, 134, SIDE_W, 26, "Load SD ROM",
             APP_RGB(48, 82, 62), APP_RGB(95, 165, 120));

    draw_btn(win, SIDE_X, 174, SIDE_W, 26, g_running ? "Pause (P)" : "Resume (P)",
             APP_BTN, APP_MID_GREY);
    draw_btn(win, SIDE_X, 206, SIDE_W, 26, "Step +1F",
             APP_BTN, APP_MID_GREY);
    draw_btn(win, SIDE_X, 238, SIDE_W, 26, "Reset (R)",
             APP_RGB(95, 45, 45), APP_RGB(170, 90, 90));

    draw_btn(win, SIDE_X,      278, 66, 26, "Save", APP_BTN, APP_MID_GREY);
    draw_btn(win, SIDE_X + 74, 278, 66, 26, "Load", APP_BTN, APP_MID_GREY);

    /* Bottom Keyboard Mapping & ROM Info Panel */
    app_fill_rect(win, 10, 306, WIN_W - 20, 86, APP_RGB(24, 27, 36));
    app_draw_rect(win, 10, 306, WIN_W - 20, 86, APP_RGB(55, 65, 85));

    app_draw_string(win, 18, 312, "KEYBOARD CONTROLS", APP_RGB(140, 185, 240));
    app_draw_string(win, 18, 330, "D-Pad : Arrows or W/A/S/D", APP_WHITE);
    app_draw_string(win, 18, 348, "A / B : Z or J  |  X or K", APP_WHITE);
    app_draw_string(win, 18, 366, "Start : Enter   |  Select : Tab", APP_RGB(200, 210, 225));

    app_fill_rect(win, 310, 312, 1, 74, APP_RGB(55, 65, 85));

    char rom_line[30];
    snprintf(rom_line, sizeof(rom_line), "ROM: %.22s", g_rom_name);
    app_draw_string(win, 320, 312, rom_line, APP_RGB(235, 220, 120));
    char res_line[30];
    snprintf(res_line, sizeof(res_line), "Video: %ux%u XRGB", g_fb_w, g_fb_h);
    app_draw_string(win, 320, 330, res_line, APP_RGB(140, 200, 255));
    app_draw_string(win, 320, 348, "P:Pause  R:Reset", APP_RGB(185, 195, 215));
    app_draw_string(win, 320, 366, "1:Save   2:Load", APP_RGB(185, 195, 215));

    /* Status Bar */
    app_fill_rect(win, 0, WIN_H - 22, WIN_W, 22, APP_RGB(14, 16, 22));
    app_draw_string(win, 10, WIN_H - 19, g_status, APP_RGB(185, 200, 220));
}

void app_main(void)
{
    pdose_select_core(0);
    app_window_t *win = app_create("PDOSE", WIN_W, WIN_H);
    if (!win) return;
    app_set_draw (win, on_draw);
    app_set_click(win, on_click);
    app_set_key  (win, on_key);
    app_set_tick (win, on_tick);
    app_run(win);
}
