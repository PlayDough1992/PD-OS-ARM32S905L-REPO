/*
 * sysmon.pda — System Monitor for PD-OS
 *
 * Build: open in PD-Text, press Build → Compile + Run
 * Or compile via terminal: tcc /home/pd/Documents/sysmon.c
 */
#include <app.h>
#include <stdio.h>
#include <string.h>
#include <stdlib.h>

#define WIN_W   380
#define WIN_H   280

static int g_cpu_pct  = 12;
static int g_ram_used = 18;
static int g_ram_max  = 64;
static int g_storage_used_gb = 1;
static int g_storage_max_gb  = 15;

static void on_click(app_window_t *win, int mx, int my)
{
    /* Refresh button at bottom right: x=270..360, y=235..265 */
    if (mx >= 270 && mx <= 360 && my >= 235 && my <= 265) {
        g_cpu_pct = 8 + (g_cpu_pct * 7 + 13) % 25;
    }
    (void)win;
}

static void draw_bar(app_window_t *win, int x, int y, int w, int h, int pct, uint32_t col)
{
    app_fill_rect(win, x, y, w, h, APP_RGB(30, 32, 40));
    app_draw_rect(win, x, y, w, h, APP_RGB(70, 75, 90));
    int fill_w = (w - 4) * pct / 100;
    if (fill_w > w - 4) fill_w = w - 4;
    if (fill_w > 0) {
        app_fill_rect(win, x + 2, y + 2, fill_w, h - 4, col);
    }
}

static void on_draw(app_window_t *win)
{
    /* Background */
    app_fill_rect(win, 0, 0, WIN_W, WIN_H, APP_BG);

    /* Header */
    app_fill_rect(win, 0, 0, WIN_W, 30, APP_RGB(30, 42, 60));
    app_draw_string(win, 12, 8, "PD-OS Hardware Resource Monitor", APP_WHITE);

    /* SoC Information */
    app_draw_string(win, 16, 42, "Hardware: Amlogic Meson S905L (Quad-Core Cortex-A53)", APP_RGB(160, 200, 255));
    app_draw_string(win, 16, 60, "Kernel: PD-OS ARM32 Monolithic with PDFS & Paging", APP_RGB(140, 140, 160));

    /* CPU Usage */
    char buf[64];
    snprintf(buf, sizeof(buf), "CPU Load: %d%%", g_cpu_pct);
    app_draw_string(win, 16, 90, buf, APP_WHITE);
    draw_bar(win, 16, 108, WIN_W - 32, 18, g_cpu_pct, APP_RGB(70, 180, 90));

    /* RAM Usage */
    int ram_pct = (g_ram_used * 100) / g_ram_max;
    snprintf(buf, sizeof(buf), "RAM Pool: %d MB / %d MB (%d%%)", g_ram_used, g_ram_max, ram_pct);
    app_draw_string(win, 16, 138, buf, APP_WHITE);
    draw_bar(win, 16, 156, WIN_W - 32, 18, ram_pct, APP_RGB(60, 140, 240));

    /* Storage */
    int st_pct = (g_storage_used_gb * 100) / g_storage_max_gb;
    snprintf(buf, sizeof(buf), "Storage: %d GB / %d GB (%d%%)", g_storage_used_gb, g_storage_max_gb, st_pct);
    app_draw_string(win, 16, 186, buf, APP_WHITE);
    draw_bar(win, 16, 204, WIN_W - 32, 18, st_pct, APP_RGB(220, 150, 40));

    /* Refresh Button */
    app_fill_rect(win, 270, 235, 90, 30, APP_RGB(50, 60, 80));
    app_draw_rect(win, 270, 235, 90, 30, APP_MID_GREY);
    app_draw_text_center(win, 315, 243, "Refresh", APP_WHITE);
}

void app_main(void)
{
    app_window_t *win = app_create("System Monitor", WIN_W, WIN_H);
    if (!win) return;
    app_set_draw (win, on_draw);
    app_set_click(win, on_click);
    app_run(win);
}
