/*
 * terminal.pda — Terminal Emulator for PD-OS
 *
 * Build: open in PD-Text, press Build → Compile + Run
 * Or compile via terminal: tcc /home/pd/Documents/terminal.c
 */
#include <app.h>
#include <stdio.h>
#include <string.h>
#include <stdlib.h>

#define WIN_W   480
#define WIN_H   320

#define MAX_HIST 12
static char g_history[MAX_HIST][64] = {
    "PD-OS ARM32 Shell v0.1 (Meson S905L)",
    "Kernel build with PDFS, Dynamic Paging & GDE GUI",
    "Type help for built-in utilities.",
    "",
    "root@pd-shell:/> uname -a",
    "PD-OS 0.1-arm32 #1 SMP PREEMPT Amlogic Meson S905L",
    "root@pd-shell:/> pdpm list",
    "[pdpm] Installed Packages:",
    "  - pd-calc v1.0.0 (Calculator)",
    "  - pd-paint v1.2.0 (Paint Studio)",
    "root@pd-shell:/> _"
};

static void on_click(app_window_t *win, int mx, int my)
{
    (void)win; (void)mx; (void)my;
}

static void on_draw(app_window_t *win)
{
    /* Terminal Black Background */
    app_fill_rect(win, 0, 0, WIN_W, WIN_H, APP_RGB(14, 16, 22));

    /* Border */
    app_draw_rect(win, 0, 0, WIN_W, WIN_H, APP_RGB(45, 55, 75));

    /* Terminal output rows */
    for (int i = 0; i < MAX_HIST; i++) {
        int y = 14 + i * 22;
        uint32_t col = APP_WHITE;
        if (strncmp(g_history[i], "root@", 5) == 0) {
            col = APP_RGB(100, 255, 120);
        } else if (strncmp(g_history[i], "PD-OS", 5) == 0) {
            col = APP_RGB(80, 180, 255);
        } else if (strncmp(g_history[i], "  -", 3) == 0) {
            col = APP_RGB(255, 210, 80);
        }
        app_draw_string(win, 12, y, g_history[i], col);
    }
}

void app_main(void)
{
    app_window_t *win = app_create("Terminal", WIN_W, WIN_H);
    if (!win) return;
    app_set_draw (win, on_draw);
    app_set_click(win, on_click);
    app_run(win);
}
